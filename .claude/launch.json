{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 3000
    },
    {
      "name": "web-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_URL=http://127.0.0.1:8787",
        "APP_ORIGIN=http://localhost:3200",
        "npm",
        "run",
        "dev",
        "-w",
        "@harbor/web",
        "--",
        "-p",
        "3200"
      ],
      "port": 3200
    },
    {
