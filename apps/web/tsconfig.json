{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@harbor/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@harbor/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2ee-mac/types/**/*.ts",
    ".next-e2ee-mac/dev/types/**/*.ts",
    ".next-polar/types/**/*.ts",
    ".next-polar/dev/types/**/*.ts",
    ".next-migration/types/**/*.ts",
    ".next-migration/dev/types/**/*.ts",
    ".next-photos/types/**/*.ts",
    ".next-photos/dev/types/**/*.ts",
    ".next-zip/types/**/*.ts",
    ".next-zip/dev/types/**/*.ts",
    ".next-photos-fast/types/**/*.ts",
    ".next-photos-fast/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
