{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@harbor/contracts": ["./packages/contracts/src/index.ts"],
      "@harbor/api-client": ["./packages/api-client/src/index.ts"]
    }
  },
  "include": [
    "apps/desktop/**/*.ts",
    "apps/desktop/**/*.tsx",
    "packages/**/*.ts",
    "infra/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/backend",
    "backend",
    "apps/desktop/test/shared-sync.test.ts",
    "apps/desktop/test/backup-drives.test.ts",
    "apps/desktop/test/device-key.test.ts",
    "apps/desktop/test/two-computers.ts",
    "apps/desktop/test/backup-storage.test.ts",
    "apps/desktop/test/sync-storage.test.ts",
    "apps/desktop/test/backup-case-names.test.ts",
    "apps/desktop/test/backup-integration.test.ts",
    "apps/desktop/test/sync-two-computers.test.ts",
    "scripts/desktop-e2ee-check.ts",
    "scripts/validate-shared-sync-live.ts",
    "apps/desktop/test/sync-batch.test.ts",
    "apps/desktop/test/sync-feed.test.ts",
    "apps/desktop/test/sync-detach-names.test.ts"
  ]
}
